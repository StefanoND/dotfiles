[Desktop Entry]
Name=VSCode
Comment=Code Editing. Redefined.
GenericName=Text Editor
Exec=/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=/app/bin/code --file-forwarding com.visualstudio.code --no-sandbox --unity-launch --user-data-dir /home/archuser/.config/Code --extensions-dir /home/archuser/.vscode/extensions @@ %F @@
Icon=com.visualstudio.code
Type=Application
StartupNotify=false
StartupWMClass=VSCode
Categories=Utility;TextEditor;Development;IDE;
MimeType=text/plain;inode/directory;application/x-codium-workspace;
Actions=new-empty-window;
Keywords=vscode;
X-Flatpak=com.visualstudio.code

[Desktop Action new-empty-window]
Name=New Empty Window
Exec=/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=/app/bin/codium --file-forwarding com.visualstudio.code --no-sandbox --new-window --user-data-dir /home/archuser/.config/VSCode --extensions-dir /home/archuser/.vscode/extensions @@ %F @@
Icon=com.visualstudio.code

