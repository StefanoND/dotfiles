# Dracula theme
[url "https://github.com/dracula/"]
  insteadOf = dracula://

[color]
  ui = auto
[color "branch"]
  current = cyan bold reverse
  local = white
  plain =
  remote = cyan
[color "diff"]
  commit =
  func = cyan
  plain =
  whitespace = magenta reverse
  meta = white
  frag = cyan bold reverse
  old = red
  new = green
[color "grep"]
  context =
  filename =
  function =
  linenumber = white
  match =
  selected =
  separator =
[color "interactive"]
  error =
  header =
  help =
  prompt =
[color "status"]
  added = green
  changed = yellow
  header =
  localBranch =
  nobranch =
  remoteBranch = cyan bold
  unmerged = magenta bold reverse
  untracked = red
  updated = green bold

[user]
  name = Stefano N. Dobbin
  email = sndobbin@gmail.com
	signingKey = DEEC83D31469B12A

[core]
  editor = nvim

[push]
  default = simple

[credential]
  helper = cache --timeout 7200
[credential "https://github.com"]
  username = StefanoND
[credential "https://gitlab.com"]
  username = StefanoND

[alias]
  co = checkout
  st = status
  unstage = reset HEAD --
  last = log -1 HEAD

[commit]
  gpgsign = true

[pull]
  rebase = false
[init]
  defaultBranch = trunk

[url "ssh://git@github.com/"]
  insteadOf = https://github.com/
[url "ssh://git@gitlab.com/"]
  insteadOf = https://gitlab.com/
[url "ssh://git@bitbucket.org/"]
  insteadOf = https://bitbucket.org/
