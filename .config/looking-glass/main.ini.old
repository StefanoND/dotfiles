[app]
shmFile=/dev/kvmfr0

[win]
title=looking-glass-client
; size=1920x1080
keepAspect=yes
borderless=yes
fullScreen=yes
uiFont=pango:Iosevka
uiSize=14
maximize=yes
showFPS=yes
noScreensaver=yes
jitRender=yes
autoResize=yes

[egl]
vsync=no
multisample=no
scale=0

[opengl]
mipmap=no
vsync=no

[wayland]
warpSupport=no
; fractionScale=yes

[input]
escapeKey=70
; rawMouse=yes

[spice]
enable=yes
