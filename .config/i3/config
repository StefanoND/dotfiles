# i3 config file (v4)
# Please see http://i3wm.org/docs/userguide.html for a complete reference!

# Set mod key (Mod1=<Alt>, Mod4=<Super>)
set $mod Mod4
set $alt Mod1

# include $HOME/dotfiles/.config/i3/settings/wideworkspaces.conf
include $HOME/dotfiles/.config/i3/settings/tripleworkspaces.conf
# include $HOME/dotfiles/.config/i3/settings/widemonitor.conf
include $HOME/dotfiles/.config/i3/settings/triplemonitor.conf
include $HOME/dotfiles/.config/i3/settings/window_gaps.conf
# include $HOME/dotfiles/.config/i3/settings/status_bar.conf
include $HOME/dotfiles/.config/i3/settings/eye_protection.conf
include $HOME/dotfiles/.config/i3/settings/manual_settings.conf

exec --no-startup-id sleep 5 && i3 restart && sleep 3 && i3 restart
